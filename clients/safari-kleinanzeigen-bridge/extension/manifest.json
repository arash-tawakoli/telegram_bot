{
  "manifest_version": 3,
  "name": "TraumWohnung Kleinanzeigen Login Helper",
  "description": "Schließt den Kleinanzeigen-Beta-Login nach dem offiziellen Login automatisch ab.",
  "version": "0.3.0",
  "permissions": [],
  "host_permissions": [
    "https://login.kleinanzeigen.de/android/com.ebay.kleinanzeigen/callback*",
    "https://dpmohkrwdlicexwcrqfy.supabase.co/functions/v1/kleinanzeigen-callback-bridge*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://login.kleinanzeigen.de/android/com.ebay.kleinanzeigen/callback*"
      ],
      "js": [
        "callback.js"
      ],
      "run_at": "document_start"
    }
  ]
}
