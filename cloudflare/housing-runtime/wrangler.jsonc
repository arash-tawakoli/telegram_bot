{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "traumwohnung-housing-runtime",
  "main": "src/index.js",
  "upload_source_maps": true,
  "compatibility_date": "2026-11-03",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "head_sampling_rate": 0.1,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true,
      "head_sampling_rate": 0.1
    }
  },
  "vars": {
    "TELEGRAM_WEBHOOK_REGISTER": "1",
    "CENTRAL_AUTO_APPLY_ENABLED": "1",
    "AUTO_APPLY_PROVIDERS": "immoscout24,immowelt,immomio,kleinanzeigen",
    "KLEINANZEIGEN_READBACK_APPLICATION_ID": "9fcf2a89-18fb-430d-a358-6ca061c9e63b"
  },
  "d1_databases": [
    {
      "binding": "HOUSING_DB",
      "database_name": "traumwohnung-housing-core",
      "database_id": "d4ee4d33-00be-4420-bb40-76d70384822d",
      "migrations_dir": "schema/d1"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DOCUMENTS",
      "bucket_name": "traumwohnung-applicant-documents"
    }
  ],
  // ImmoScout sweeps (sources 1, 69, 72) run in their own queue invocation, not inside the cron run.
  // Create the queue once before deploying: wrangler queues create immoscout-sweep
  // Previews do not inherit this producer binding and cannot consume the queue.
  "queues": {
    "producers": [
      { "queue": "immoscout-sweep", "binding": "IMMOSCOUT_SWEEP_QUEUE" }
    ],
    "consumers": [
      {
        "queue": "immoscout-sweep",
        "max_batch_size": 1,
        "max_batch_timeout": 0,
        "max_retries": 0,
        "max_concurrency": 3
      }
    ]
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "previews": {
    "vars": {
      "PREVIEW_MODE": "1",
      "TELEGRAM_WEBHOOK_REGISTER": "0",
      "CENTRAL_AUTO_APPLY_ENABLED": "0",
      "AUTO_APPLY_PROVIDERS": ""
    }
  },
  "limits": {
    "cpu_ms": 30000
  }
}

