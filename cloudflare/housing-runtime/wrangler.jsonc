{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "traumwohnung-housing-runtime",
  "main": "src/index.js",
  "upload_source_maps": true,
  "compatibility_date": "2026-11-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true,
      "head_sampling_rate": 0.1
    }
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "25a37f1631e54fc09f7f650a9557ea1c"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "previews": {}
}
