{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "traumwohnung-housing-runtime",
  "main": "src/index.js",
  "upload_source_maps": true,
  "compatibility_date": "2026-11-03",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true,
      "head_sampling_rate": 0.1
    }
  },
  "d1_databases": [
    {
      "binding": "LEGACY_D1",
      "database_name": "immoscout-central-token-staging",
      "database_id": "08789b5f-f200-4985-a357-276052206852"
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "25a37f1631e54fc09f7f650a9557ea1c"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "previews": {
    "d1_databases": [
      {
        "binding": "LEGACY_D1",
        "database_name": "immoscout-central-token-staging",
        "database_id": "08789b5f-f200-4985-a357-276052206852"
      }
    ],
    "hyperdrive": [
      {
        "binding": "HYPERDRIVE",
        "id": "25a37f1631e54fc09f7f650a9557ea1c"
      }
    ],
    "vars": {
      "PREVIEW_MODE": "1",
      "SUPABASE_URL": "https://dpmohkrwdlicexwcrqfy.supabase.co",
      "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_vaW_Ib4H58o5uK4B-8hRfQ_KujeBwqJ"
    }
  },
  "vars": {
    "SUPABASE_URL": "https://dpmohkrwdlicexwcrqfy.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_vaW_Ib4H58o5uK4B-8hRfQ_KujeBwqJ"
  },
  "limits": {
    "cpu_ms": 500
  }
}

