{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "traumwohnung-waha",
  "main": "src/index.js",
  "compatibility_date": "2026-11-17",
  "containers": [
    {
      "class_name": "WahaHost",
      "scheduling_policy": "durable_object",
      "images": {
        "base": { "dockerfile": "./Dockerfile" }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "WAHA", "class_name": "WahaHost" }
    ]
  },
  "exports": {
    "WahaHost": { "type": "durable-object", "storage": "sqlite" }
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "WAHA_ENABLED": "0"
  }
}
